# --- macOS junk ---
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes

# --- Proprietary Synology firmware / packages / docs — NEVER redistribute ---
*.pat
*.spk
*.pdf

# --- Extracted firmware roots (proprietary) & build outputs ---
DS207/workspace/*_extracted/
DS207/workspace/toolchain/
DS207/workspace/assistant/
DS207/workspace/build/deliverables/
DS207/workspace/build/samba/
DS207/workspace/build/ds207_patch/payload/
DS216/

# --- Binaries / archives / large blobs ---
*.tgz
*.tar
*.tar.gz
*.zip
*.exe
*.dll
*.so
*.so.*
*.a
*.o
*.core
*.dat
*.mmdb

# --- Compiled test/output binaries (no extension) ---
*.ppc
*_ppc
DS207/workspace/build/sbin/
DS207/workspace/build/bin/

# --- Installer bundle binaries (ship via GitHub Releases, not git) ---
DS207/workspace/build/installer/ds207-modern/payload/sbin/
DS207/workspace/build/installer/ds207-modern/payload/ssh/
DS207/workspace/build/installer/ds207-modern/payload/bin/
DS207/workspace/build/installer/ds207-modern/payload/ssl/
DS207/workspace/build/installer/ds207-modern/payload/ui/
DS207/workspace/build/installer/*.tar.gz
DS207/workspace/build/installer/*.zip

# --- Logs ---
*.log

# --- Browser-automation scratch (Playwright MCP screenshots/console logs) ---
.playwright-mcp/

# --- Shipped release assets (committed in-repo, linked from INSTALL.md) ---
# The general *.tar.gz / installer rules above keep build artifacts out of git;
# this carve-out re-includes only the published installer bundles under releases/
# (not macOS ._ junk, which the rules at the top still ignore).
!releases/*.tar.gz
DS207/workspace/build/dashboard/ppc/

# dashboard UI
DS207/workspace/build/dashboard-ui/node_modules/
DS207/workspace/build/dashboard-ui/dist/
DS207/workspace/build/dashboard/www/
